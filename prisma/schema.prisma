generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int           @id @default(autoincrement())
  username           String        @unique
  password           String
  rol                String
  activo             Boolean       @default(true)
  createdAt          DateTime      @default(now())
  chargesRegistrados ExtraCharge[] @relation("ChargesRegistrados")
  chargesAnulados    ExtraCharge[] @relation("ChargesAnulados")
}

model TokenInvalidado {
  id        Int      @id @default(autoincrement())
  jti       String   @unique
  expiraEn  DateTime

  @@index([expiraEn])
}

model Guest {
  id           Int           @id @default(autoincrement())
  nombre       String
  email        String
  dni          String        @unique
  telefono     String?
  activo       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  reservations Reservation[]
}

model Room {
  id           Int           @id @default(autoincrement())
  numero       String        @unique
  tipo         String
  tarifa       Int
  estado       String        @default("DISPONIBLE")
  capacidad    Int           @default(1)
  descripcion  String?
  comodidades  String?
  fotos        String?
  createdAt    DateTime      @default(now())
  reservations Reservation[]
}

model Reservation {
  id                Int      @id @default(autoincrement())
  guestId           Int
  roomId            Int
  checkIn           DateTime
  checkOut          DateTime
  noches            Int
  total             Int
  estado            String   @default("CONFIRMADA")
  adultos           Int      @default(1)
  menores           Int      @default(0)
  codigo            String?  @unique
  notas             String?
  motivoCancelacion String?
  multaCancelacion  Int      @default(0)
  earlyCheckIn      Boolean  @default(false)
  lateCheckOut      Boolean  @default(false)
  createdAt         DateTime @default(now())
  guest             Guest    @relation(fields: [guestId], references: [id])
  room              Room     @relation(fields: [roomId], references: [id])
  extraCharges      ExtraCharge[]

  @@index([roomId, checkIn, checkOut])
  @@index([guestId])
  @@index([checkIn])
  @@index([checkOut])
}

model Season {
  id          Int      @id @default(autoincrement())
  roomType    String
  fechaInicio DateTime
  fechaFin    DateTime
  tarifa      Int
  createdAt   DateTime @default(now())

  @@index([roomType, fechaInicio, fechaFin])
}

model WeekdayRate {
  id        Int      @id @default(autoincrement())
  roomType  String
  diaSemana Int
  tarifa    Int
  createdAt DateTime @default(now())

  @@unique([roomType, diaSemana])
}

model HotelExtra {
  id          Int           @id @default(autoincrement())
  codigo      String        @unique
  nombre      String
  categoria   String
  precio      Int
  unidad      String
  activo      Boolean       @default(true)
  descripcion String?
  creadoEn    DateTime      @default(now())
  charges     ExtraCharge[]
}

model ExtraCharge {
  id              Int          @id @default(autoincrement())
  reservationId   Int
  extraId         Int
  cantidad        Int
  precioUnitario  Int
  importe         Int
  estado          String       @default("PENDIENTE")
  nota            String?
  registradoPorId Int
  anuladoPorId    Int?
  anuladoEn       DateTime?
  creadoEn        DateTime     @default(now())
  reservation     Reservation  @relation(fields: [reservationId], references: [id])
  extra           HotelExtra   @relation(fields: [extraId], references: [id])
  registradoPor   User         @relation("ChargesRegistrados", fields: [registradoPorId], references: [id])
  anuladoPor      User?        @relation("ChargesAnulados", fields: [anuladoPorId], references: [id])

  @@index([reservationId, estado])
  @@index([extraId, creadoEn])
  @@index([estado])
}
