generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                        Int                 @id @default(autoincrement())
  username                  String              @unique
  password                  String
  rol                       String
  activo                    Boolean             @default(true)
  createdAt                 DateTime            @default(now())
  housekeepingTasksAsignado HousekeepingTask[]  @relation("HousekeepingTaskAsignadoA")
  maintenanceReportado      MaintenanceTicket[] @relation("MaintenanceTicketReportadoPor")
  maintenanceAsignado       MaintenanceTicket[] @relation("MaintenanceTicketAsignadoA")
  auditLogs                 AuditLog[]
  chargesRegistrados        ExtraCharge[]       @relation("ChargesRegistrados")
  chargesAnulados           ExtraCharge[]       @relation("ChargesAnulados")
}

model TokenInvalidado {
  id       Int      @id @default(autoincrement())
  jti      String   @unique
  expiraEn DateTime

  @@index([expiraEn])
}

model Guest {
  id           Int           @id @default(autoincrement())
  nombre       String
  email        String
  dni          String        @unique
  telefono     String?
  activo       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  reservations Reservation[]
}

model Room {
  id                 Int                 @id @default(autoincrement())
  numero             String              @unique
  tipo               String
  tarifa             Int
  estado             String              @default("DISPONIBLE")
  capacidad          Int                 @default(1)
  descripcion        String?
  comodidades        String?
  fotos              String?
  createdAt          DateTime            @default(now())
  reservations       Reservation[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]
}

model Reservation {
  id                Int           @id @default(autoincrement())
  guestId           Int
  roomId            Int
  checkIn           DateTime
  checkOut          DateTime
  noches            Int
  total             Int
  estado            String        @default("CONFIRMADA")
  adultos           Int           @default(1)
  menores           Int           @default(0)
  codigo            String?       @unique
  notas             String?
  motivoCancelacion String?
  multaCancelacion  Int           @default(0)
  earlyCheckIn      Boolean       @default(false)
  lateCheckOut      Boolean       @default(false)
  createdAt         DateTime      @default(now())
  guest             Guest         @relation(fields: [guestId], references: [id])
  room              Room          @relation(fields: [roomId], references: [id])
  payments          Payment[]
  extraCharges      ExtraCharge[]

  @@index([roomId, checkIn, checkOut])
  @@index([guestId])
  @@index([checkIn])
  @@index([checkOut])
}

model Season {
  id          Int      @id @default(autoincrement())
  roomType    String
  fechaInicio DateTime
  fechaFin    DateTime
  tarifa      Int
  createdAt   DateTime @default(now())

  @@index([roomType, fechaInicio, fechaFin])
}

model WeekdayRate {
  id        Int      @id @default(autoincrement())
  roomType  String
  diaSemana Int
  tarifa    Int
  createdAt DateTime @default(now())

  @@unique([roomType, diaSemana])
}

model HotelExtra {
  id          Int           @id @default(autoincrement())
  codigo      String        @unique
  nombre      String
  categoria   String
  precio      Int
  unidad      String
  activo      Boolean       @default(true)
  descripcion String?
  creadoEn    DateTime      @default(now())
  charges     ExtraCharge[]
}

model ExtraCharge {
  id              Int         @id @default(autoincrement())
  reservationId   Int
  extraId         Int
  cantidad        Int
  precioUnitario  Int
  importe         Int
  estado          String      @default("PENDIENTE")
  nota            String?
  registradoPorId Int
  anuladoPorId    Int?
  anuladoEn       DateTime?
  creadoEn        DateTime    @default(now())
  reservation     Reservation @relation(fields: [reservationId], references: [id])
  extra           HotelExtra  @relation(fields: [extraId], references: [id])
  registradoPor   User        @relation("ChargesRegistrados", fields: [registradoPorId], references: [id])
  anuladoPor      User?       @relation("ChargesAnulados", fields: [anuladoPorId], references: [id])

  @@index([reservationId, estado])
  @@index([extraId, creadoEn])
  @@index([estado])
}

model HousekeepingTask {
  id              Int      @id @default(autoincrement())
  roomId          Int
  tipo            String
  estado          String
  asignadoAId     Int?
  fechaProgramada DateTime
  observaciones   String?
  creadoEn        DateTime @default(now())
  actualizadoEn   DateTime @updatedAt
  room            Room     @relation(fields: [roomId], references: [id])
  asignadoA       User?    @relation("HousekeepingTaskAsignadoA", fields: [asignadoAId], references: [id])

  @@index([roomId, estado])
  @@index([estado, fechaProgramada])
  @@index([asignadoAId, estado])
}

model MaintenanceTicket {
  id             Int       @id @default(autoincrement())
  roomId         Int
  tipo           String
  prioridad      String
  estado         String
  descripcion    String
  resolucion     String?
  reportadoPorId Int
  asignadoAId    Int?
  creadoEn       DateTime  @default(now())
  actualizadoEn  DateTime  @updatedAt
  resueltoEn     DateTime?
  room           Room      @relation(fields: [roomId], references: [id])
  reportadoPor   User      @relation("MaintenanceTicketReportadoPor", fields: [reportadoPorId], references: [id])
  asignadoA      User?     @relation("MaintenanceTicketAsignadoA", fields: [asignadoAId], references: [id])

  @@index([roomId, estado])
  @@index([estado, prioridad])
}

model Payment {
  id            Int         @id @default(autoincrement())
  reservationId Int
  monto         Int
  metodo        String
  pagadoEn      DateTime
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  @@index([pagadoEn])
  @@index([reservationId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  accion    String
  recurso   String
  recursoId String?
  detalle   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId, accion])
}
